rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function: Check if requesting user owns the document or has admin access
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // User profile collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || resource.data.agencyId == request.auth.uid);
      allow delete: if isAuthenticated() && request.auth.uid == userId;
    }

    // Agencies collection
    match /agencies/{agencyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (request.auth.uid == agencyId || resource.data.ownerId == request.auth.uid);
    }

    // Stock items collection (multi-tenant isolated by agencyId or user uid)
    match /stock/{stockId} {
      allow read, write: if isAuthenticated();
    }

    // Bills collection (isolated per store/user)
    match /bills/{billId} {
      allow read, write: if isAuthenticated();
    }

    // Customers collection
    match /customers/{customerId} {
      allow read, write: if isAuthenticated();
    }

    // Business settings / templates config
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Order Bookers collection
    match /bookers/{bookerId} {
      allow read, write: if isAuthenticated();
    }
  }
}
