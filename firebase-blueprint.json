{
  "entities": {
    "DailyTransaction": {
      "title": "Daily Transaction",
      "description": "Daily shop cash flow record (cash in, cash out, counter bills, etc.)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["opening", "in", "out", "bill_add", "payment"] },
        "amount": { "type": "number" },
        "description": { "type": "string", "maxLength": 500 },
        "transaction_date": { "type": "string" },
        "created_by": { "type": "string" },
        "party_type": { "type": "string", "enum": ["customer", "wholesaler", "none"] },
        "bill_id": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "type", "amount", "description", "transaction_date", "created_by"]
    },
    "BackCashTransaction": {
      "title": "Back Cash Transaction",
      "description": "Owner back cash receiving or cash out record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["receiving", "out"] },
        "amount": { "type": "number" },
        "note": { "type": "string", "maxLength": 500 },
        "transaction_date": { "type": "string" },
        "created_by": { "type": "string" },
        "created_at": { "type": "string" }
      },
      "required": ["id", "type", "amount", "note", "transaction_date", "created_by"]
    },
    "WholesalerBill": {
      "title": "Wholesaler Bill",
      "description": "Supplier / Wholesaler credit ledger account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "supplier_name": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "total_amount": { "type": "number" },
        "paid_amount": { "type": "number" },
        "remaining_balance": { "type": "number" },
        "created_date": { "type": "string" },
        "status": { "type": "string", "enum": ["paid", "pending", "overdue"] }
      },
      "required": ["id", "supplier_name", "total_amount", "paid_amount", "remaining_balance", "created_date", "status"]
    },
    "CustomerBill": {
      "title": "Customer Bill",
      "description": "Customer Udhaar / credit ledger account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customer_name": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "total_amount": { "type": "number" },
        "paid_amount": { "type": "number" },
        "remaining_balance": { "type": "number" },
        "created_date": { "type": "string" },
        "status": { "type": "string", "enum": ["paid", "pending", "overdue"] }
      },
      "required": ["id", "customer_name", "total_amount", "paid_amount", "remaining_balance", "created_date", "status"]
    },
    "EasyloadRecord": {
      "title": "Easyload Record",
      "description": "Daily mobile easyload sale & balance tracker per network",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "jazz_open": { "type": "number" },
        "jazz_purchase": { "type": "number" },
        "jazz_close": { "type": "number" },
        "telenor_open": { "type": "number" },
        "telenor_purchase": { "type": "number" },
        "telenor_close": { "type": "number" },
        "zong_open": { "type": "number" },
        "zong_purchase": { "type": "number" },
        "zong_close": { "type": "number" },
        "ufone_open": { "type": "number" },
        "ufone_purchase": { "type": "number" },
        "ufone_close": { "type": "number" },
        "purchases": { "type": "array" }
      },
      "required": ["date"]
    },
    "BottleItem": {
      "title": "Bottle Item",
      "description": "Stock inventory item with crate/pet counts and purchase/sale prices",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 200 },
        "category": { "type": "string" },
        "total_stock": { "type": "number" },
        "bottles_per_pet": { "type": "number" },
        "empty_stock": { "type": "number" },
        "purchase_price": { "type": "number" },
        "sale_price": { "type": "number" },
        "pet_purchase_price": { "type": "number" },
        "pet_sale_price": { "type": "number" }
      },
      "required": ["id", "name", "total_stock", "purchase_price", "sale_price"]
    },
    "DeletedHistoryRecord": {
      "title": "Deleted History Record",
      "description": "Audit trash log of deleted transactions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "original_id": { "type": "string" },
        "source": { "type": "string" },
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "note": { "type": "string" },
        "transaction_date": { "type": "string" },
        "deleted_by": { "type": "string" },
        "deleted_at": { "type": "string" }
      },
      "required": ["id", "original_id", "source", "amount", "deleted_by", "deleted_at"]
    }
  },
  "firestore": {
    "/daily_transactions/{txId}": {
      "schema": "DailyTransaction",
      "description": "All shop cash book transactions"
    },
    "/back_cash_transactions/{txId}": {
      "schema": "BackCashTransaction",
      "description": "All back cash transactions"
    },
    "/wholesaler_bills/{billId}": {
      "schema": "WholesalerBill",
      "description": "Supplier credit and ledger bills"
    },
    "/customer_bills/{billId}": {
      "schema": "CustomerBill",
      "description": "Customer khata credit accounts"
    },
    "/easyload_records/{dateId}": {
      "schema": "EasyloadRecord",
      "description": "Daily mobile easyload sale & balance per network"
    },
    "/bottle_items/{itemId}": {
      "schema": "BottleItem",
      "description": "Inventory and stock products"
    },
    "/deleted_history/{delId}": {
      "schema": "DeletedHistoryRecord",
      "description": "Audit logs for deleted items"
    }
  }
}
